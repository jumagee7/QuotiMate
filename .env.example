# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored; never commit real keys.
#
# Build with:
#   flutter build apk --release --split-per-abi --dart-define-from-file=.env
#
# These values are compiled into the app and can be extracted from the APK.
# Treat them as public identifiers: restrict each key in its provider console.

GROQ_API_KEY=your_groq_api_key

# Firebase Web API key (Google Cloud Console → APIs & Services → Credentials).
# Restrict it to the Firestore API and, where possible, to your app's package.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_PROJECT_ID=quotimate-cloud
